@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@model library_management_system.Models.SearchResultsViewModel

@{
	ViewData["lang"] = System.Globalization.CultureInfo.CurrentCulture.Name;
}

<section class="mb-5">
	<h2 class="display-5">@Localizer["New Movies"]</h2>
	@if (Model.OnlineSearchFailed)
	{
		<div class="alert alert-warning" role="alert">
			<p class="mb-2">@Localizer["The online movie search failed on this attempt."]</p>
			<p class="mb-3">@Localizer["Would you like to try again or add the item manually?"]</p>
			<form hx-post="/Movies/SearchResultsOnline" hx-target="#searchResultsOnline" hx-indicator="#retryIndicator-Movie-@Model.CacheKey" class="d-inline-block">
				<input type="hidden" name="LoanId" value="@Model.LoanId" />
				<input type="hidden" name="Title" value="@Model.Title" />
				<input type="hidden" name="Director" value="@Model.Director" />
				<input type="hidden" name="ReleaseYear" value="@Model.ReleaseYear" />
				<input type="hidden" name="EAN" value="@Model.EAN" />
				<button type="submit" class="btn btn-primary">
					<span id="retryIndicator-Movie-@Model.CacheKey" class="retry-indicator spinner-border spinner-border-sm me-2" role="status" aria-hidden="true" aria-label="@Localizer["Loading..."]"></span>
					<span>@Localizer["Retry"]</span>
				</button>
			</form>
			<form method="get" asp-controller="Movies" asp-action="New" class="d-inline-block ms-2">
				<input type="hidden" name="LoanId" value="@Model.LoanId" />
				<input type="hidden" name="Movie.Title" value="@Model.Title" />
				<input type="hidden" name="Movie.Director" value="@Model.Director" />
				<input type="hidden" name="Movie.ReleaseYear" value="@Model.ReleaseYear" />
				<input type="hidden" name="Movie.EAN" value="@Model.EAN" />
				<button type="submit" class="btn btn-outline-primary">@Localizer["Add item manually"]</button>
			</form>
		</div>
		<style>
			.retry-indicator {
				display: none;
			}
			.htmx-request .retry-indicator,
			.htmx-request.retry-indicator {
				display: inline-block;
			}
		</style>
	}
	else if (Model.Movies.Count > 0)
	{
		<output class="row">
			<table class="table">
				<colgroup>
					<col class="col-5">
					</col>
					<col class="col-3">
					</col>
					<col class="col-1">
					</col>
					<col class="col-1">
					</col>
					<col class="col-2">
					</col>
				</colgroup>
				<thead>
					<tr>
						<th scope="col">@Localizer["Title"]</th>
						<th scope="col">@Html.DisplayNameFor(model => model.Movies.First().Director)</th>
						<th scope="col">@Html.DisplayNameFor(model => model.Movies.First().ReleaseYear)</th>
						<th scope="col">@Html.DisplayNameFor(model => model.Movies.First().Media)</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var movie in Model.Movies)
					{
						<tr>
							<td class="align-middle">@("fr".Equals(ViewData["lang"]) ? movie.TitleFr ?? movie.Title : movie.Title)</td>
							<td class="align-middle">@Html.DisplayFor(model => movie.Director)</td>
							<td class="align-middle">@Html.DisplayFor(model => movie.ReleaseYear)</td>
							<td class="align-middle">@Html.DisplayFor(model => movie.Media)</td>
							<td class="text-md-end">
								@if (Model.LoanId != null)
								{
									<form asp-controller="LoanMovies" asp-action="Create">
										<input type="hidden" name="LoanId" value="@Model.LoanId" />
										<input type="hidden" name="Movie.Title" value="@movie.Title" />
										<input type="hidden" name="Movie.TitleFr" value="@movie.TitleFr" />
										<input type="hidden" name="Movie.Director" value="@movie.Director" />
										<input type="hidden" name="Movie.ReleaseYear" value="@movie.ReleaseYear" />
										<input type="hidden" name="Movie.Media" value="@movie.Media" />
										<input type="hidden" name="Movie.EAN" value="@movie.EAN" />

										<button type="submit" class="btn btn-outline-primary text-nowrap"
											autofocus="@(Model.Movies.Count == 1)"
											>@Localizer["Add to Loan"]</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</output>
	}
	else
	{
		<div>
			@Localizer["No movies found."]
		</div>
	}
</section>
